# Airtable Personal Access Token (scopes: data.records:read, data.records:write)
AIRTABLE_API_KEY=

# Airtable Base ID (starts with app...)
AIRTABLE_BASE_ID=

# Airtable Table IDs (start with tbl..., or exact table names)
AIRTABLE_BLOG_TABLE_ID=
AIRTABLE_EVENTS_TABLE_ID=
AIRTABLE_LEARN_TABLE_ID=
AIRTABLE_IDEAS_TABLE_ID=
AIRTABLE_COMMENTS_TABLE_ID=

# Optional: legacy Airtable gallery table (gallery currently uses static files in public/images/gallery)
# AIRTABLE_GALLERY_TABLE_ID=

# Secret token for POST /api/revalidate (generate with: openssl rand -hex 32)
REVALIDATE_SECRET=

# Simple team passcode to log into /admin
ADMIN_PASSCODE=
